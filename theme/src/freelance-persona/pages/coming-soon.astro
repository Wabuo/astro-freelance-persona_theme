---
// theme/src/freelance-persona/pages/coming-soon.astro
/*
 * SPDX-FileCopyrightText: 2026 The freelance-persona_theme Project Contributors
 * SPDX-License-Identifier: MIT
 */

import BaseLayout from "@freelance-persona/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { themeConfig } from "@freelance-persona/config";
import { resolveLink } from "@freelance-persona/utils/linkUtils";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg}",
);
const imagePath = themeConfig.visuals?.mascot_image;
const lancyImageModule =
  imagePath && images[imagePath] ? await images[imagePath]() : null;
const lancyImage = lancyImageModule?.default;

const title = "Coming Soon";
const description = "We are working hard to bring you this page.";
---

<BaseLayout title={title} description={description} navType="page">
  <section
    class="section coming-soon flex flex-col items-center justify-center"
  >
    <div class="container text-center" data-reveal="fade-up">
      <div class="mascot-container flow-root mb-6">
        {
          lancyImage ? (
            <Image
              src={lancyImage}
              alt="Mascot working on something new"
              width={350}
              height={350}
              class="max-w-full h-auto mx-auto lancy-working"
            />
          ) : (
            <div
              class="mascot-placeholder"
              style="width:350px; height:350px; display:inline-block; border: 2px dashed var(--accent-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 4rem; color: var(--accent-color);"
            >
              <Icon name="bi:tools" />
            </div>
          )
        }
      </div>

      <h1>Watch This Space!</h1>
      <h2>Something Awesome is Brewing</h2>
      <p class="mb-6">
        Lancy is currently coding this feature.<br />
        Check back soon for updates!
      </p>

      <a href={resolveLink("/")} class="btn mt-2 md:mt-4"> Back to Home </a>
    </div>
  </section>
</BaseLayout>

<style>
@layer components {

  .coming-soon {
    min-height: 80vh;
    padding: 4rem 0;

    h1 {
      font-size: 4.5rem;
      font-weight: 700;
      color: var(--heading-color);
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 2rem;
      color: var(--accent-color);
      margin-bottom: 1.5rem;
      font-family: var(--font-heading);
    }

    p {
      font-size: 1.2rem;
      color: var(--text-muted);
    }

    .lancy-working {
      max-width: 100%;
      height: auto;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.1));
      /* Pulse animation for "working" vibe */
      animation: pulse 3s infinite ease-in-out;
    }


    /* Mobile Compact Layout */
    @media (max-width: 768px) {
      min-height: 85vh;
      padding: 1rem 0 2rem 0;

      h1 {
        font-size: 2.5rem;
        margin-bottom: 0.25rem;
      }
      h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
      }
      p {
        font-size: 1rem;
        margin-bottom: 1.5rem;
      }

      .lancy-working {
        width: 180px;
        margin-bottom: 1rem;
      }
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1);
    }
  }
}
</style>
