---
// src/freelance-persona/layouts/BaseLayout.astro
import Footer from "@freelance-persona/components/Footer.astro";
import Navigation from "@freelance-persona/components/Navigation.astro";
import { themeConfig } from "@freelance-persona/config";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Font imports
import "@fontsource/raleway/latin-400.css";
import "@fontsource/raleway/latin-700.css";

// --- DYNAMIC FONT PRELOADING (PageSpeed Optimization) ---
// To get a 100/100 Mobile PageSpeed score, we preload the critical font files (.woff2)
// used above the fold. This prevents layout shifts (CLS) and delays in rendering text (LCP).
//
// Why here and not in freelance-persona.config.ts?
// - Web E2E tests (Playwright) and node scripts import the config file directly in a Node.js 
//   environment. Node.js does not understand Vite's "?url" asset query suffix and would crash.
// Why not in fonts.ts?
// - CSS imports in fonts.ts only bundle the fonts, but they do not expose the final resolved 
//   asset URLs to JavaScript. We need these URLs here to render `<link rel="preload">` in the HTML.
//
// How to adapt if you change fonts in freelance-persona.config.ts:
// 1. Install your new font: `bun add @fontsource/your-font`
// 2. Import its CSS weights in `theme/starter/src/fonts.ts`
// 3. (Optional but recommended) Import the `.woff2?url` asset of your new font below,
//    and add it to the FONT_PRELOAD_MAP.
//    Supported out of the box: Raleway, Poppins, Roboto, Inter, Open Sans, Source Sans 3, Montserrat
import raleway700Url from "@fontsource/raleway/files/raleway-latin-700-normal.woff2?url";
import poppins300Url from "@fontsource/poppins/files/poppins-latin-300-normal.woff2?url";
import roboto400Url from "@fontsource/roboto/files/roboto-latin-400-normal.woff2?url";

// Map of font family name (lowercase) to preload URL
// Add more entries here when adding new fonts to the theme
const FONT_PRELOAD_MAP: Record<string, string> = {
  raleway: raleway700Url,
  poppins: poppins300Url,
  roboto: roboto400Url,
};

// Import Global Styles
// NOTE: UnoCSS utilities are injected automatically by the integration
// (unocss/astro adds "virtual:uno.css" to page entries). Do not manually
// import it here — that produces a duplicate-import build warning.
import "@freelance-persona/styles/main.css";

// --- SMART ASSET DISCOVERY ---
async function findAsset(glob: Record<string, () => Promise<any>>) {
  const paths = Object.keys(glob);
  if (paths.length === 0) return null;
  paths.sort((a, b) => {
    const score = (p: string) =>
      p.endsWith(".svg")
        ? 4
        : p.endsWith(".png")
        ? 3
        : p.endsWith(".ico")
        ? 2
        : 0;
    return score(b) - score(a);
  });
  const selectedPath = paths[0];
  const mod = await glob[selectedPath]();
  return mod.default;
}

const faviconSrc = await findAsset(
  import.meta.glob("/src/assets/img/favicon.{svg,ico,png,webp}", {
    query: { url: "" },
  })
);
const appleSrc = await findAsset(
  import.meta.glob("/src/assets/img/apple-touch-icon.{png,svg,webp}", {
    query: { url: "" },
  })
);

const getAssetUrl = (asset: any) => {
  if (!asset) return "";
  if (typeof asset === "string") return asset;
  if (typeof asset === "object" && asset.src) return asset.src;
  return "";
};

const getMime = (asset: any) => {
  if (!asset) return "image/x-icon";
  if (typeof asset === "object" && asset.format) {
    if (asset.format === "svg") return "image/svg+xml";
    if (asset.format === "png") return "image/png";
    if (asset.format === "webp") return "image/webp";
    return `image/${asset.format}`;
  }
  if (typeof asset === "string") {
    if (/\.svg($|\?)/.test(asset)) return "image/svg+xml";
    if (/\.png($|\?)/.test(asset)) return "image/png";
    if (/\.ico($|\?)/.test(asset)) return "image/x-icon";
    if (/\.webp($|\?)/.test(asset)) return "image/webp";
  }
  return "image/x-icon";
};

interface Props {
  title?: string;
  description?: string;
  tex?: boolean;
  navType?: "home" | "page";
  page_margin_left?: string;
  page_margin_right?: string;
  nav_menu_width?: string;
  nav_pill_expanded_width?: string;
  preloadImageUrl?: string;
  /** Optional robots meta directive, e.g. "noindex, noarchive".
      Absent = no robots meta is emitted. */
  robots?: string;
  /** Per-page og:image override (built or absolute URL). Falls back to
      themeConfig.seo.og_image. */
  ogImage?: string;
  /** og:type — "website" (default) or "article" for blog posts. */
  ogType?: string;
  /** article:published_time for og:type "article" (ISO 8601). */
  publishedTime?: string;
}

const {
  title = themeConfig.title,
  description = themeConfig.description,
  tex = false,
  navType = "page",
  preloadImageUrl,
  robots,
  ogImage,
  ogType,
  publishedTime,
} = Astro.props;

// --- Open Graph image resolution -------------------------------------------
// Precedence: page/post ogImage > themeConfig.seo.og_image. Source asset
// paths ("/src/assets/...") resolve through the Vite asset pipeline; built
// and absolute URLs pass through. Emits nothing without a resolvable
// absolute URL (Astro.site unset).
let ogImageUrl: string | undefined;
const ogImageSource = ogImage ?? themeConfig.seo?.og_image;
if (ogImageSource) {
  if (/^https?:\/\//.test(ogImageSource)) {
    ogImageUrl = ogImageSource;
  } else if (ogImageSource.startsWith('/src/assets/')) {
    const images =
      import.meta.glob<{ default: ImageMetadata }>(
        '/src/assets/**/*.{jpeg,jpg,png,webp,gif,svg}',
      );
    const mod = images[ogImageSource] ? await images[ogImageSource]() : null;
    if (mod) {
      // Raster PNG at OG dimensions: WhatsApp & friends don't draw SVG
      // (or reliably WebP) in link previews. Sharp rasterizes SVG sources
      // at build time; the page itself keeps serving the SVG/WebP.
      const optimized = await getImage({
        src: mod.default,
        format: 'png',
        width: 1200,
        quality: 'high',
      });
      ogImageUrl = optimized.src;
    }
  } else {
    ogImageUrl = ogImageSource;
  }
  if (ogImageUrl && Astro.site) {
    ogImageUrl = new URL(ogImageUrl, Astro.site).href;
  } else {
    ogImageUrl = undefined;
  }
}

// --- JSON-LD structured data (search-engine rich results) ------------------
// Emitted centrally: WebSite + Person on the homepage (navType "home"),
// BlogPosting on posts (ogType "article" + publishedTime). Serialized
// strings double as the CSP hash source — see the registration below.
const siteRootUrl = Astro.site
  ? new URL(import.meta.env.BASE_URL, Astro.site).href
  : undefined;
const jsonLdScripts: string[] = [];
if (siteRootUrl) {
  if (navType === 'home') {
    jsonLdScripts.push(
      JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: themeConfig.title,
        url: siteRootUrl,
        description,
      }),
    );
    jsonLdScripts.push(
      JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: themeConfig.author,
        url: siteRootUrl,
        ...(themeConfig.social_links?.length && {
          sameAs: themeConfig.social_links.map((link) => link.url),
        }),
      }),
    );
  }
  if (ogType === 'article' && publishedTime) {
    jsonLdScripts.push(
      JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: publishedTime,
        url: Astro.url.href,
        mainEntityOfPage: Astro.url.href,
        ...(ogImageUrl && { image: [ogImageUrl] }),
        author: {
          '@type': 'Person',
          name: themeConfig.author,
          url: siteRootUrl,
        },
      }),
    );
  }
}

const bodyClass = navType === "home" ? "home-page" : "inner-page";

// --- LAYOUT LOGIC ---
const layout = themeConfig.visuals?.layout || {};
const globalMarginLeft =
  Astro.props.page_margin_left || layout.page_margin_left || "140px";
const globalMarginRight =
  Astro.props.page_margin_right || layout.page_margin_right || globalMarginLeft;

const navMenuWidth = 
  Astro.props.nav_menu_width || layout.nav_menu_width || "8.75rem";
const navPillExpandedWidth = 
  Astro.props.nav_pill_expanded_width || layout.nav_pill_expanded_width || "11.25rem";

// --- FONTS CONFIGURATION ---
const fonts = themeConfig.fonts || {};
const colors = themeConfig.colors || {};

// Level 4: Code Fallback (Fontsource Defaults) with Auto-Fallback Stack
const headingFont = fonts.headings
  ? (fonts.headings.includes(",") ? fonts.headings : `"${fonts.headings}", sans-serif`)
  : '"Adwaita Sans", sans-serif';

const bodyFont = fonts.body
  ? (fonts.body.includes(",") ? fonts.body : `"${fonts.body}", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif`)
  : '"Adwaita Sans", sans-serif';

const navFont = fonts.navigation
  ? (fonts.navigation.includes(",") ? fonts.navigation : `"${fonts.navigation}", sans-serif`)
  : '"Raleway", sans-serif';

const monospaceFont = fonts.monospace
  ? (fonts.monospace.includes(",") ? fonts.monospace : `"${fonts.monospace}", Courier, monospace`)
  : '"Adwaita Mono", Courier, monospace';

// --- DYNAMIC FONT PRELOADING ---
const cleanFontName = (fontStr: string) => {
  if (!fontStr) return "";
  return fontStr.split(',')[0].replace(/['"]/g, '').trim().toLowerCase();
};

const headingsFontName = cleanFontName(headingFont);
const bodyFontName = cleanFontName(bodyFont);
const navFontName = cleanFontName(navFont);

// Dynamically determine which fonts to preload based on configured font families
const fontRoles = [
  { name: headingsFontName, weight: '400' }, // headings - typically bold
  { name: bodyFontName, weight: '400' },     // body - regular
  { name: navFontName, weight: '300' },      // navigation - light
];

const preloadUrls: string[] = [];

for (const role of fontRoles) {
  const fontKey = role.name;
  const preloadUrl = FONT_PRELOAD_MAP[fontKey];
  if (preloadUrl && !preloadUrls.includes(preloadUrl)) {
    preloadUrls.push(preloadUrl);
  }
}

// ---------------------------------------------------------------------
// Inline scripts — declared as constants so their content can be hashed
// and registered with Astro's CSP (see Astro.csp registration below).
// Deliberately is:inline + set:html: they must run before first paint
// (see To_Do.md — a bundled deferred module would cause reveal flash).
// ---------------------------------------------------------------------
import { createHash } from "node:crypto";

const safetyTimeoutScript = `
// SAFETY TIMEOUT PATTERN
// 1. We start by assuming JS might be loading.
document.documentElement.classList.add("js-loading");
document.documentElement.classList.remove("no-js");

// 2. Safety Net: If the notification script doesn't run within 2 seconds
// (due to blocking, network error, crash), we force show everything.
setTimeout(function () {
  document.documentElement.classList.remove("js-loading");
}, 2000);
`;

const themeSyncScript = `
// Restore persisted theme preference by checking the matching radio input.
// No data-theme attribute needed — Expressive Code and all other styles use
// the same CSS-native :has() + @media selectors as the rest of the site.
const t = localStorage.getItem("theme");
if (t === "light" || t === "dark") {
  const el = document.getElementById("theme-" + t);
  if (el) el.checked = true;
}
`;

const removePreloaderScript = `
function removePreloader() {
  const preloader = document.getElementById("preloader");
  if (preloader) {
    preloader.style.opacity = "0";
    setTimeout(() => {
      preloader.style.display = "none";
    }, 250);
  }
}
// Run on DOMContentLoaded or load (whichever fires first)
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", removePreloader);
} else {
  removePreloader();
}
window.addEventListener("load", removePreloader);

// Safety timeout
setTimeout(removePreloader, 500);
`;

// Animation engine — interpolates the user's scroll/delay config, so its
// hash is computed per render (identical across pages of one build).
const animationEngineScript = `
const userAnimConfig = ${JSON.stringify(themeConfig.visuals?.scroll_animations || {})};
const animConfig = Object.assign({
  enabled: true,
  duration: 500,
  delay: 0,
  threshold: 0.1,
  root_margin: "0px 0px -50px 0px"
}, userAnimConfig);
const delaysConfig = ${JSON.stringify(themeConfig.visuals?.delays || {})};

const initScrollAnimations = () => {
  // Transition from 'loading' to 'ready' state
  document.documentElement.classList.add("js-ready");
  document.documentElement.classList.remove("js-loading");

  if (!animConfig.enabled) {
    document.querySelectorAll("[data-reveal]").forEach((el) => {
      el.classList.add("revealed");
      el.style.opacity = "1";
      el.style.transform = "none";
    });
    return;
  }

  const elements = document.querySelectorAll("[data-reveal]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: animConfig.threshold,
      rootMargin: animConfig.root_margin,
    },
  );

  elements.forEach((el) => {
    // Skip elements already revealed during VT swap (instant-reveal)
    if (el.classList.contains("revealed")) {
      el.style.transition = "";
      return;
    }

    // Apply duration from config if not overridden inline
    if (!el.style.transitionDuration) {
      el.style.transitionDuration = animConfig.duration + "ms";
    }

    // --- DELAY LOGIC ---
    let delay = 0;
    const inlineDelay = el.getAttribute("data-reveal-delay");

    if (inlineDelay) {
      delay = parseInt(inlineDelay, 10);
    } else {
      // Check if element is a MAIN heading.
      // Be stricter: Only H1, H2, or explicit .section-title.
      // Do NOT count H3-H6 as layout headings (allows 'pills' to be content).
      const isHeading =
        /^(H[1-2])$/i.test(el.tagName) ||
        el.classList.contains("section-title");

      if (isHeading) {
         delay = delaysConfig.heading || 0;
      } else {
         delay = delaysConfig.content || 0;
      }

      // Fallback to animConfig generic delay if specific ones aren't set
      if (delay === 0 && animConfig.delay) {
         delay = animConfig.delay;
      }
    }

    if (delay) {
      el.style.transitionDelay = delay + "ms";
    }

    // --- STAGGERING SUPPORT (Minimal) ---
    // Automatically stagger children if this element is a grid container.
    // We look for common item patterns: .info-item (Contact), .post-entry (Blog).
    const gridItems = el.querySelectorAll('.info-item, .post-entry');
    if (gridItems.length > 1) {
       const staggerTime = delaysConfig.stagger || 150;
       gridItems.forEach((item, index) => {
          if (!item.style.transition) {
             item.style.transition = "opacity " + animConfig.duration + "ms ease-out, transform " + animConfig.duration + "ms ease-out";
             item.style.transitionDelay = (delay + (index * staggerTime)) + "ms";
          } else {
             item.style.transitionDelay = (delay + (index * staggerTime)) + "ms";
          }
       });
    }

    observer.observe(el);
  });
};

// Navigation Event Listener
const runInit = () => {
  if (!document.documentElement.classList.contains("anim-init")) {
      initScrollAnimations();
      document.documentElement.classList.add("anim-init");
  }
};

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", runInit);
} else {
  runInit();
}
`;

// Register script hashes with Astro's CSP (no-op when security.csp is off).
if (Astro.csp) {
  for (const script of [
    safetyTimeoutScript,
    themeSyncScript,
    removePreloaderScript,
    animationEngineScript,
    ...jsonLdScripts,
  ]) {
    Astro.csp.insertScriptHash(
      `sha256-${createHash("sha256").update(script).digest("base64")}`,
    );
  }
}
---

<!DOCTYPE html>
<html lang="en" class="no-js" data-test-mode={__TEST_MODE__ ? "true" : undefined} data-animations={themeConfig.visuals?.scroll_animations?.enabled === false ? "disabled" : undefined}>
  <head>
    <meta charset="utf-8" />

    <!-- CSS cascade layer order (must precede every stylesheet link).
         uno.config.ts sets outputToCssLayers, so UnoCSS emits real @layer
         blocks: theme vars → `theme`, preflight reset → `base`, utilities
         → `utilities`. Declaring them here keeps vendor layers below the
         theme's `components` while utilities stay on top.
         First declaration wins: omitting a name would let it silently
         land after `components`. -->
    <style is:inline>@layer theme, base, components, utilities;</style>

    <!-- Preload critical fonts for immediate rendering -->
    {
      preloadUrls.map((url) => (
        <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
      ))
    }
    {
      preloadImageUrl && (
        <link rel="preload" href={preloadImageUrl} as="image" />
      )
    }
  {/* Dynamic Theme Config */}
  <style
    is:inline
    id="theme-config"
    data-astro-transition-persist="theme-config"
    set:html={`
    html:root {
      --global-margin-left: ${globalMarginLeft}; 
      --global-margin-right: ${globalMarginRight};
      --nav-menu-width: ${navMenuWidth};
      --nav-pill-expanded-width: ${navPillExpandedWidth};
      --font-heading: ${headingFont};
      --font-body: ${bodyFont};
      --font-nav: ${navFont};
      --font-mono: ${monospaceFont};

      /* --- COLOR overrides --- */
      /* LIGHT / DEFAULT */
      ${
        colors.light?.background
          ? `--background-color: ${colors.light.background};`
          : ""
      }
      ${colors.light?.text ? `--default-color: ${colors.light.text};` : ""}
      ${colors.light?.heading ? `--heading-color: ${colors.light.heading};` : ""}
      ${colors.light?.accent ? `--accent-color: ${colors.light.accent};` : ""}
      ${colors.light?.surface ? `--surface-color: ${colors.light.surface};` : ""}
      ${colors.light?.contrast ? `--contrast-color: ${colors.light.contrast};` : ""}
      ${colors.light?.muted ? `--text-muted: ${colors.light.muted};` : ""}

      /* Component Overrides (Light) */
      ${
        colors.light?.card_background
          ? `--card-background: ${colors.light.card_background};`
          : ""
      }
      ${
        colors.light?.card_border
          ? `--card-border: ${colors.light.card_border};`
          : ""
      }
      ${
        colors.light?.code_background
          ? `--code-background: ${colors.light.code_background};`
          : ""
      }
      ${
        colors.light?.tag_background
          ? `--tag-background: ${colors.light.tag_background};`
          : ""
      }
      ${colors.light?.tag_text ? `--tag-text: ${colors.light.tag_text};` : ""}
      ${colors.light?.tag_border ? `--tag-border: ${colors.light.tag_border};` : ""}
      ${
        colors.light?.input_background
          ? `--input-background: ${colors.light.input_background};`
          : ""
      }
      ${
        colors.light?.input_border
          ? `--input-border: ${colors.light.input_border};`
          : ""
      }
      ${colors.light?.input_text ? `--input-text: ${colors.light.input_text};` : ""}

      /* Navigation (Light) */
      ${colors.light?.nav_color ? `--nav-color: ${colors.light.nav_color};` : ""}
      ${
        colors.light?.nav_hover_color
          ? `--nav-hover-color: ${colors.light.nav_hover_color};`
          : ""
      }
      ${
        colors.light?.nav_mobile_background
          ? `--nav-mobile-background-color: ${colors.light.nav_mobile_background};`
          : ""
      }
      ${
        colors.light?.nav_dropdown_background
          ? `--nav-dropdown-background-color: ${colors.light.nav_dropdown_background};`
          : ""
      }
      ${
        colors.light?.nav_dropdown_color
          ? `--nav-dropdown-color: ${colors.light.nav_dropdown_color};`
          : ""
      }
      ${
        colors.light?.nav_dropdown_hover
          ? `--nav-dropdown-hover-color: ${colors.light.nav_dropdown_hover};`
          : ""
      }
      ${
        colors.light?.header_background
          ? `--header-background-color: ${colors.light.header_background};`
          : ""
      }
      ${
        colors.light?.header_color
          ? `--header-color: ${colors.light.header_color};`
          : ""
      }

      /* Shared */
      ${colors.transparency ? `--transparency: ${colors.transparency};` : ""}

      /* Font Size Overrides */
      ${fonts.sizes?.normal ? `--normal-font-size: ${fonts.sizes.normal};` : ""}
      ${fonts.sizes?.footer ? `--footer-font-size: ${fonts.sizes.footer};` : ""}
      ${fonts.sizes?.heading ? `--heading-font-size: ${fonts.sizes.heading};` : ""}
      ${
        fonts.sizes?.subtitle
          ? `--subtitle-font-size: ${fonts.sizes.subtitle};`
          : ""
      }
      ${fonts.sizes?.title ? `--title-font-size: ${fonts.sizes.title};` : ""}
      ${fonts.sizes?.nav_icon ? `--nav-icon-size: ${fonts.sizes.nav_icon};` : ""}
    }
    `}
  />
  {/* Dynamic Dark Mode Overrides */}

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    @media (prefers-reduced-motion: no-preference) {
      @view-transition {
        navigation: auto;
      }
    }
  </style>

  {
    /* Dynamic Dark Mode Overrides - Moved to HEAD for ViewTransition compatibility */
  }
  {
    colors.dark && (
      <style
        is:inline
        id="theme-dynamic-styles"
        data-astro-transition-persist="theme-dynamic-styles"
        set:html={`
        @media (prefers-color-scheme: dark) {
          html:root:not(:has(.theme-state-light:checked)) {
            ${
              colors.dark.background
                ? `--background-color: ${colors.dark.background};`
                : ""
            }
            ${
              colors.dark.text
                ? `--default-color: ${colors.dark.text};`
                : ""
            }
            ${
              colors.dark.heading
                ? `--heading-color: ${colors.dark.heading};`
                : ""
            }
            ${
              colors.dark.accent
                ? `--accent-color: ${colors.dark.accent};`
                : ""
            }
            ${
              colors.dark.surface
                ? `--surface-color: ${colors.dark.surface};`
                : ""
            }
            ${
              colors.dark.contrast
                ? `--contrast-color: ${colors.dark.contrast};`
                : ""
            }
            ${
              colors.dark.muted
                ? `--text-muted: ${colors.dark.muted};`
                : ""
            }
  
            ${
              colors.dark.card_background
                ? `--card-background: ${colors.dark.card_background};`
                : ""
            }
            ${
              colors.dark.card_border
                ? `--card-border: ${colors.dark.card_border};`
                : ""
            }
            ${
              colors.dark.code_background
                ? `--code-background: ${colors.dark.code_background};`
                : ""
            }
            ${
              colors.dark.tag_background
                ? `--tag-background: ${colors.dark.tag_background};`
                : ""
            }
            ${
              colors.dark.tag_text
                ? `--tag-text: ${colors.dark.tag_text};`
                : ""
            }
            ${
              colors.dark.tag_border
                ? `--tag-border: ${colors.dark.tag_border};`
                : ""
            }
            ${
              colors.dark.input_background
                ? `--input-background: ${colors.dark.input_background};`
                : ""
            }
            ${
              colors.dark.input_border
                ? `--input-border: ${colors.dark.input_border};`
                : ""
            }
            ${
              colors.dark.input_text
                ? `--input-text: ${colors.dark.input_text};`
                : ""
            }
  
            ${
              colors.dark.nav_color
                ? `--nav-color: ${colors.dark.nav_color};`
                : ""
            }
            ${
              colors.dark.nav_hover_color
                ? `--nav-hover-color: ${colors.dark.nav_hover_color};`
                : ""
            }
            ${
              colors.dark.nav_mobile_background
                ? `--nav-mobile-background-color: ${colors.dark.nav_mobile_background};`
                : ""
            }
            ${
              colors.dark.nav_dropdown_background
                ? `--nav-dropdown-background-color: ${colors.dark.nav_dropdown_background};`
                : `--nav-dropdown-background-color: var(--surface-color);`
            }
            ${
              colors.dark.nav_dropdown_color
                ? `--nav-dropdown-color: ${colors.dark.nav_dropdown_color};`
                : ""
            }
            ${
              colors.dark.nav_dropdown_hover
                ? `--nav-dropdown-hover-color: ${colors.dark.nav_dropdown_hover};`
                : ""
            }
            ${
              colors.dark.header_background
                ? `--header-background-color: ${colors.dark.header_background};`
                : `--header-background-color: color-mix(in srgb, var(--background-color), transparent 5%);`
            }
            ${
              colors.dark.header_color
                ? `--header-color: ${colors.dark.header_color};`
                : ""
            }
          }
        }
        
        @media (prefers-color-scheme: light) {
          html:root:has(.theme-state-dark:checked) {
            ${
              colors.dark.background
                ? `--background-color: ${colors.dark.background};`
                : ""
            }
            ${
              colors.dark.text
                ? `--default-color: ${colors.dark.text};`
                : ""
            }
            ${
              colors.dark.heading
                ? `--heading-color: ${colors.dark.heading};`
                : ""
            }
            ${
              colors.dark.accent
                ? `--accent-color: ${colors.dark.accent};`
                : ""
            }
            ${
              colors.dark.surface
                ? `--surface-color: ${colors.dark.surface};`
                : ""
            }
            ${
              colors.dark.contrast
                ? `--contrast-color: ${colors.dark.contrast};`
                : ""
            }
            ${
              colors.dark.muted
                ? `--text-muted: ${colors.dark.muted};`
                : ""
            }
  
            ${
              colors.dark.card_background
                ? `--card-background: ${colors.dark.card_background};`
                : ""
            }
            ${
              colors.dark.card_border
                ? `--card-border: ${colors.dark.card_border};`
                : ""
            }
            ${
              colors.dark.code_background
                ? `--code-background: ${colors.dark.code_background};`
                : ""
            }
            ${
              colors.dark.tag_background
                ? `--tag-background: ${colors.dark.tag_background};`
                : ""
            }
            ${
              colors.dark.tag_text
                ? `--tag-text: ${colors.dark.tag_text};`
                : ""
            }
            ${
              colors.dark.tag_border
                ? `--tag-border: ${colors.dark.tag_border};`
                : ""
            }
            ${
              colors.dark.input_background
                ? `--input-background: ${colors.dark.input_background};`
                : ""
            }
            ${
              colors.dark.input_border
                ? `--input-border: ${colors.dark.input_border};`
                : ""
            }
            ${
              colors.dark.input_text
                ? `--input-text: ${colors.dark.input_text};`
                : ""
            }
  
            ${
              colors.dark.nav_color
                ? `--nav-color: ${colors.dark.nav_color};`
                : ""
            }
            ${
              colors.dark.nav_hover_color
                ? `--nav-hover-color: ${colors.dark.nav_hover_color};`
                : ""
            }
            ${
              colors.dark.nav_mobile_background
                ? `--nav-mobile-background-color: ${colors.dark.nav_mobile_background};`
                : ""
            }
            ${
              colors.dark.nav_dropdown_background
                ? `--nav-dropdown-background-color: ${colors.dark.nav_dropdown_background};`
                : `--nav-dropdown-background-color: var(--surface-color);`
            }
            ${
              colors.dark.nav_dropdown_color
                ? `--nav-dropdown-color: ${colors.dark.nav_dropdown_color};`
                : ""
            }
            ${
              colors.dark.nav_dropdown_hover
                ? `--nav-dropdown-hover-color: ${colors.dark.nav_dropdown_hover};`
                : ""
            }
            ${
              colors.dark.header_background
                ? `--header-background-color: ${colors.dark.header_background};`
                : `--header-background-color: color-mix(in srgb, var(--background-color), transparent 5%);`
            }
            ${
              colors.dark.header_color
                ? `--header-color: ${colors.dark.header_color};`
                : ""
            }
        }
      `}
      />
    )
  }

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={themeConfig.author} />
  <link rel="canonical" href={Astro.url.href} />
  {robots && <meta name="robots" content={robots} />}

  {/* Open Graph / Twitter — social link-preview cards */}
  <meta property="og:site_name" content={themeConfig.title} />
  <meta property="og:title" content={title} />
  <meta property="og:type" content={ogType ?? 'website'} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:description" content={description} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  {jsonLdScripts.map((json) => <script type="application/ld+json" is:inline set:html={json} />)}

  {
    faviconSrc && (
      <link
        rel="icon"
        type={getMime(faviconSrc)}
        href={getAssetUrl(faviconSrc)}
      />
    )
  }
  {appleSrc && <link rel="apple-touch-icon" href={getAssetUrl(appleSrc)} />}

  <meta name="generator" content={Astro.generator} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <script is:inline set:html={safetyTimeoutScript} />

  {
    /* CRITICAL: Fallback for users without JavaScript.
      Without this, elements with data-reveal will remain invisible (opacity: 0).
    */
  }
  <noscript>
    <style>
      /* 1. Hide the preloader completely if JS is disabled */
      #preloader {
        display: none !important;
        visibility: hidden !important;
      }

      /* 2. Force all animated elements to be visible and reset their positions */
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    </style>
  </noscript>
  </head>
  <body class={bodyClass} data-tex={tex}>
    <!-- Hidden radio state for theme management (No JS fallback) -->
    <input
      type="radio"
      name="theme-state"
      id="theme-os"
      class="theme-state-os sr-only"
      tabindex="-1"
      aria-label="System Default Theme"
      checked
      style="position: fixed;"
    />
    <input
      type="radio"
      name="theme-state"
      id="theme-light"
      class="theme-state-light sr-only"
      tabindex="-1"
      aria-label="Light Theme"
      style="position: fixed;"
    />
    <input
      type="radio"
      name="theme-state"
      id="theme-dark"
      class="theme-state-dark sr-only"
      tabindex="-1"
      aria-label="Dark Theme"
      style="position: fixed;"
    />

    <script is:inline set:html={themeSyncScript} />

    <a class="skip-link" href="#main">Skip to content</a>

    <Navigation isHome={navType === "home"} />

    <main class="main" id="main">
      <slot />
    </main>

    <Footer />

    <div id="preloader" data-astro-transition-persist="preloader"></div>

    <script is:inline set:html={removePreloaderScript} />

    {
      /* 
        ANIMATION ENGINE (Unified)
        Replaces AOS with a lightweight, config-driven IntersectionObserver.
        Uses manual JSON injection to avoid Astro bundling issues.
    */
    }
    <script is:inline set:html={animationEngineScript}></script>
  </body>
</html>
