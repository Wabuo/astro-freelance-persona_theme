---
interface Props {
  crumbs: { label: string; href?: string }[];
  showTitle?: boolean;
}
const { crumbs, showTitle = true } = Astro.props;
---

<section id="breadcrumbs" class="page-title">
  <div class="container flex flex-col justify-center">
    <div class="breadcrumbs">
      <ol>
        {
          crumbs.map((crumb, index) => (
            <li>
              {index === crumbs.length - 1 || !crumb.href ? (
                <span>{crumb.label}</span>
              ) : (
                <a href={crumb.href}>{crumb.label}</a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
    {showTitle && <h1>{crumbs[crumbs.length - 1].label}</h1>}
  </div>
</section>

<style is:global>
  /* Component-owned styles (shipped only when this component is used) */
  @import "@freelance-persona/styles/breadcrumbs.css";
</style>
