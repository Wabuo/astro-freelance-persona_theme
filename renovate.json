{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "commitMessagePrefix": "🚨 SECURITY FIX: "
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false
    },
    {
      "comment": "Fragile-set dependency bumps must pass the visual suite before merge",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchPackageNames": [
        "astro",
        "unocss",
        "@unocss/preset-wind4",
        "expressive-code",
        "astro-expressive-code",
        "lightningcss",
        "sharp",
        "mathjax-full",
        "rehype-mathjax"
      ],
      "labels": ["run-visual-tests"]
    },
    {
      "matchPackageNames": ["katex", "rehype-katex"],
      "groupName": "KaTeX and Rehype-KaTeX"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am"],
    "commitMessageAction": "Update and optimize lockfile graph"
  }
}
