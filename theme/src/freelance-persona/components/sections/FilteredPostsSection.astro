---
// src/components/sections/Recent_PostsSection.astro
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "@freelance-persona/utils/slugify";
import ImageAttribution from "@freelance-persona/components/ui/ImageAttribution.astro";
import SectionTitle from "@freelance-persona/components/ui/SectionTitle.astro";
import Card from "@freelance-persona/components/ui/Card.astro";
import { Icon } from "astro-icon/components";
import { getExcerpt } from "@freelance-persona/utils/excerpt";
import PostPreviewMock from "@freelance-persona/components/ui/PostPreviewMock.astro";

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  tags_to_filter_posts_by?: string[];
  posts?: any[];
  limit?: number;
  columns?: number;
  scale?: number;
  gutter?: "default" | "wide"; // "default" = gy-4 1.5rem (inner pages), "wide" = 2rem (home page)
  layout?: "cards" | "rows"; // "cards" = grid cards ≥768 + news rows <768 (default); "rows" = news rows at ALL widths
}
const {
  id,
  title,
  subtitle,
  tags_to_filter_posts_by,
  posts,
  limit = 3,
  columns = 3,
  scale = 1,
  gutter = "default",
  layout = "cards",
} = Astro.props;

// 1. Fetch ALL posts (only if posts not provided)
const allPosts = posts ? [] : await getCollection("blog_posts");

// 2. Filter Logic
let filteredPosts = posts || [];
if (!posts) {
  filteredPosts = tags_to_filter_posts_by
    ? allPosts.filter((post) =>
        post.data.tags?.some((tag: string) =>
          tags_to_filter_posts_by.includes(tag),
        ),
      )
    : allPosts;
}

// 3. Sort by Date & LIMIT
const displayedPosts = filteredPosts
  .sort((a: any, b: any) => {
    const dateDiff = b.data.date.valueOf() - a.data.date.valueOf();
    if (dateDiff !== 0) return dateDiff;
    return b.id.localeCompare(a.id);
  })
  .slice(0, limit === -1 ? undefined : limit);
// 4. Layout Classes (semantic grid)
// Gutter model: negative margins on the
// container, matching padding + gutter-top margin on every cell.
const isWide = gutter === "wide";
// The small negative top-margin keeps the header->first-post distance
// comfortable (cell top-margins supply the inter-row spacing).
const gridWrap = isWide ? "-mx-[1rem]" : "-mx-[0.75rem]";
const cellPad  = isWide ? "px-[1rem]"        : "px-[0.75rem]";
const cellMt   = isWide ? "mt-[2rem]"        : "mt-[1.5rem]";
const gridCols = layout === "rows"
  ? "grid grid-cols-1"
  : columns === 4
    ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    : "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3";
const cellClass = `post-card-cell mb-6 max-md:mb-3 ${cellMt} ${cellPad}`;
const colClass = `${gridWrap} ${gridCols}`;

// 5. Excerpt Helper
// Excerpt helper moved to @freelance-persona/utils/excerpt (shared with
// the list-page teaser rows).

---

{/* Only render the section if we actually found posts for this category */}
{
  displayedPosts.length > 0 && (
    <section
      id={id}
      class={`filtered-posts section ${layout === "rows" ? "rows" : ""}`}
      style={`
        --scale-factor: ${scale};
        ${isWide ? "--fp-hairline-gap: 2.75rem;" : ""}
        /* Downsize key variables by the scale factor */
        --h2-font-size: calc(2rem * var(--scale-factor)); 
        --h3-font-size: calc(1.75rem * var(--scale-factor));
        --normal-font-size: calc(1rem * var(--scale-factor));
        --small-font-size: calc(0.875rem * var(--scale-factor));
        --spacing-sm: calc(1rem * var(--scale-factor));
        --spacing-md: calc(2rem * var(--scale-factor));
      `}
    >
      <SectionTitle title={title} subtitle={subtitle} />

      <div class="container" data-reveal="fade-up">
        <div class={colClass}>
          {displayedPosts.map((post) => (
            <div class={cellClass}>
              <Card href={`${import.meta.env.BASE_URL}posts/${post.id.split("/").pop()}`} class="h-full">
                {/* Image Slot */}
                <div slot="image" class="post-image-container">
                  {post.data.thumbnail ? (
                    <>
                      <Image
                        src={post.data.thumbnail}
                        alt={post.data.title}
                        class="max-w-full h-auto post-image"
                        width={600}
                        quality="high"
                        format={post.data.thumbnail.format === 'svg' ? 'svg' : 'webp'}
                        loading="eager"
                        decoding="sync"
                      />
                      {/* Attribution overlay */}
                      <ImageAttribution
                        img_credit={post.data.img_credit}
                        img_copyright={post.data.img_copyright}
                        img_license={post.data.img_license}
                        position={post.data.img_attribution_position}
                        theme={post.data.img_attribution_theme}
                        disableLinks={true}
                      />
                    </>
                  ) : (
                    <PostPreviewMock
                      title={post.data.title}
                      tags={post.data.tags}
                      date={post.data.date}
                      excerpt={getExcerpt(post.body)}
                    />
                  )}
                </div>

                <div class="post-details">
                  <div class="post-content">
                    <h3 class="post-card-title">
                      {post.data.title}
                    </h3>
                    <p class="post-card-desc">
                      {post.data.description || "Click to read more..."}
                    </p>
                  </div>
                </div>

                {/* Mobile heise rows: full-width meta line below text+thumb —
                    tag bottom-left, date bottom-right. Desktop keeps the
                    absolute date inside the details. */}
                <div class="post-meta-row">
                  <div class="meta">
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="inline-block">
                        {post.data.tags.map((tag: string) => {
                          const isFiltered =
                            tags_to_filter_posts_by?.includes(tag);
                          return (
                            <span
                              class={`tag badge me-1 ${isFiltered ? "active" : ""}`}
                            >
                              {tag}
                            </span>
                          );
                        })}
                      </div>
                    )}
                  </div>

                  {/* Date at Bottom Right */}
                  <span
                    class="date"
                  >
                    {post.data.date.toLocaleDateString("en-GB", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric",
                    })}
                  </span>
                </div>
              </Card>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}



<style is:global>
  /* Component-owned styles (shipped only when this component is used) */
  @import "@freelance-persona/styles/_filtered-posts.css" layer(components);
</style>

<style>
@layer components {

  /* Component styles live in styles/_blog-categories.css (recent-posts block) */

  /* Local Fix for Attribution Positioning */
  :global(.post-image-container) {
    position: relative;
    overflow: hidden; /* Ensure attribution stays within image bounds */
  }
}
</style>


<style is:global>
  /* Card-facing post primitives (.post-header/.post-title/.meta-top) render here too,
     so this partial ships wherever those cards appear. */
  @import "@freelance-persona/styles/blog-post.css" layer(components);
</style>
