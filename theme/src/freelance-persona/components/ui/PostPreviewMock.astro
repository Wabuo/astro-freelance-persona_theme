// Miniature "page preview" render used when a post has no thumbnail:
// post cards on the home sections and the list-page teaser thumbs.
//
// Renders a miniature of a DESKTOP post view: a 1280×720 (16:9)
// reference viewport scaled to whatever box it lands in. Every size is
// expressed in cqw (% of box width), i.e. design-px / 12.8, so the
// whole scene — nav padding, centered content column, badges with
// their padding — scales as one uniform miniature. Readability is not
// a goal — it is a thumbnail of text content.
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  tags?: string[];
  date?: Date;
  excerpt?: string;
}

const { title, tags = [], date, excerpt = "" } = Astro.props;

const dateStr = date?.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<div class="preview-card-wrapper">
  <div class="mock-page-content">
    {/* Fade Out Mask Overlay */}
    <div class="mock-fade" />

    <div class="post-header">
      <h2 class="post-title">{title}</h2>

      <div class="post-tags">
        {tags.length > 0
          ? tags.map((tag) => (
            <span class="tag badge">
              {tag.toLowerCase()}
            </span>
          ))
          : (
            <span class="tag badge">blog</span>
          )}
      </div>

      <hr class="mock-hr mock-hr-wide" />

      <div class="meta-top">
        <Icon name="bi:calendar-event" class="me-1" />
        {dateStr}
        <span class="mock-sep">|</span>
        <Icon name="bi:hourglass-split" class="me-1" />1 min read
      </div>

      <hr class="mock-hr" />

      <div class="post-content">
        <p>{excerpt}</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* The box this component fills is the size reference: all sizes in
     cqw = the 1280px desktop viewport scaled to fit (design-px/12.8),
     identical proportions at any thumb size. Scoped = overrides the
     shared blog-post.css partials (unlayered component styles >
     layered partials). */
  .preview-card-wrapper {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .mock-page-content {
    width: 100%;
    height: 100%;
    padding: 2.5cqw;
    background-color: var(--surface-color, #fff);
    color: var(--default-color);
    overflow: hidden;
    position: relative;
  }

  .mock-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 25%;
    background: linear-gradient(to bottom, transparent, var(--surface-color, #fff));
    z-index: 2;
    pointer-events: none;
  }

  /* Centered content column — the desktop container look. */
  .mock-page-content .post-header {
    width: 62.5cqw;
    margin-inline: auto;
  }

  .mock-page-content .post-title {
    font-size: 3.13cqw;
    line-height: 1.2;
    margin-bottom: 0.63cqw;
    color: var(--heading-color);
  }

  .post-tags {
    margin-bottom: 0;
  }

  /* Badge chrome scales with the miniature: the global badge style is
     fixed-rem (padding/radius/margins) and would dwarf 1cqw-scale
     text inside small thumbs. 0.31cqw = 4px, 0.63cqw = 8px,
     0.23cqw = 3px at the 1280px design. */
  .mock-page-content .tag.badge {
    font-size: 0.94cqw;
    padding: 0.31cqw 0.63cqw;
    border-radius: 0.23cqw;
    margin-inline-end: 0.63cqw;
    margin-block-end: 0.31cqw;
  }

  .mock-page-content .mock-hr {
    margin: 0.63cqw 0;
    opacity: 0.2;
    border-top: 0.16cqw solid;
  }

  .mock-page-content .mock-hr-wide {
    margin: 0.94cqw 0;
  }

  .mock-page-content .meta-top {
    display: flex;
    align-items: center;
    margin-bottom: 1.25cqw;
    font-size: 1.09cqw;
    color: var(--text-muted);
  }

  .mock-page-content .mock-sep {
    margin-inline: 0.31cqw;
  }

  .mock-page-content .post-content {
    font-size: 1.25cqw;
    line-height: 1.6;
    white-space: pre-line;
  }
</style>
